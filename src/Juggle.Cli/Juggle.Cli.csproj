<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>juggle</AssemblyName>
    <RootNamespace>Juggle.Cli</RootNamespace>
    <!-- On Linux, without the ICU library (a Pi's image has none): juggle only needs invariant formatting -->
    <InvariantGlobalization Condition="$(RuntimeIdentifier.StartsWith('linux'))">true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Juggle.Core\Juggle.Core.csproj" />
  </ItemGroup>

</Project>
