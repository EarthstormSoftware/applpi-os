<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Juggle.Flash.ViewModels"
             x:Class="Juggle.Flash.Views.SshKeyView"
             x:DataType="vm:SshKeyViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Classes="buttons">
      <Button Content="Cancel" Command="{Binding CancelCommand}" />
      <Button Classes="accent" Content="I've made it" Command="{Binding DoneCommand}" />
    </StackPanel>
    <StackPanel Spacing="10" MaxWidth="560" HorizontalAlignment="Left">
      <TextBlock Classes="title" Text="{Binding Title}" />
      <TextBlock TextWrapping="Wrap" Text="You have no SSH key yet: it's how you log in to the Pi. Make one in a terminal with this command. It asks for a passphrase, which protects the key if anyone copies it (or press Enter twice for none)." />
      <SelectableTextBlock Text="{Binding Command}" FontFamily="Consolas, Menlo, monospace" TextWrapping="Wrap" Margin="12,4" />
      <TextBlock Classes="error" Text="{Binding Problem}" IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>
  </DockPanel>
</UserControl>
