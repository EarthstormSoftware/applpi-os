<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Juggle.Flash.ViewModels"
             x:Class="Juggle.Flash.Views.JobView"
             x:DataType="vm:JobViewModel">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Classes="title" Text="{Binding Title}" />

    <!-- Below the log: where the job has got, and the way back once it has ended -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <StackPanel DockPanel.Dock="Right" Classes="buttons" Margin="16,0,0,0" VerticalAlignment="Bottom">
        <Button Name="DoneButton" Classes="accent" Content="Back to start" Command="{Binding HomeCommand}" />
      </StackPanel>
      <StackPanel Spacing="6" VerticalAlignment="Bottom">
        <StackPanel Spacing="6" IsVisible="{Binding ShowsProgress}">
          <TextBlock Text="{Binding ProgressText}" />
          <ProgressBar Value="{Binding ProgressValue}" Maximum="100" IsIndeterminate="{Binding !ProgressKnown}" />
        </StackPanel>
        <TextBlock Name="StatusText" Text="{Binding Status}" FontWeight="SemiBold" />
      </StackPanel>
    </DockPanel>

    <!-- The log: everything the job has said -->
    <Border CornerRadius="6" Padding="12,8" BorderThickness="1"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <ScrollViewer Name="Log">
        <ItemsControl ItemsSource="{Binding Lines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:JobLine">
              <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,2" Classes.error="{Binding IsProblem}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </DockPanel>
  <UserControl.Styles>
    <Style Selector="SelectableTextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" />
    </Style>
  </UserControl.Styles>
</UserControl>
