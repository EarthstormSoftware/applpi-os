<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Juggle.Flash.ViewModels"
             x:Class="Juggle.Flash.Views.PiNameView"
             x:DataType="vm:PiNameViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Classes="buttons">
      <Button Content="Cancel" Command="{Binding CancelCommand}" />
      <Button Classes="accent" Content="Continue" Command="{Binding ContinueCommand}" />
    </StackPanel>
    <StackPanel Spacing="10" MaxWidth="460" HorizontalAlignment="Left">
      <TextBlock Classes="title" Text="{Binding Title}" />
      <TextBox Text="{Binding Name}" PlaceholderText="kitchen" />
      <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>
  </DockPanel>
</UserControl>
