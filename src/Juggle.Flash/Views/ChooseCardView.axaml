<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Juggle.Flash.ViewModels"
             x:Class="Juggle.Flash.Views.ChooseCardView"
             x:DataType="vm:ChooseCardViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Classes="buttons">
      <Button Content="Cancel" Command="{Binding CancelCommand}" />
      <Button Classes="accent" Content="Continue" Command="{Binding ContinueCommand}" />
    </StackPanel>
    <StackPanel Spacing="10" MaxWidth="560" HorizontalAlignment="Left">
      <TextBlock Classes="title" Text="{Binding Title}" />
      <TextBlock Classes="note" Text="There's more than one Juggle card in this computer's card readers." />
      <ListBox ItemsSource="{Binding Cards}" SelectedIndex="{Binding SelectedIndex}" />
    </StackPanel>
  </DockPanel>
</UserControl>
