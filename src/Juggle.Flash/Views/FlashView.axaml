<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Juggle.Flash.ViewModels"
             x:Class="Juggle.Flash.Views.FlashView"
             x:DataType="vm:FlashViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Classes="buttons">
      <Button Content="Back" Command="{Binding HomeCommand}" />
      <Button Name="StartButton" Classes="accent" Content="Continue" Command="{Binding StartCommand}" />
    </StackPanel>
    <StackPanel Spacing="10" MaxWidth="560" HorizontalAlignment="Left">
      <TextBlock Classes="title" Text="{Binding Title}" />
      <TextBlock Text="The image" FontWeight="SemiBold" />
      <RadioButton GroupName="image" IsChecked="{Binding IsLatest}" Content="The latest release, downloaded from GitHub" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <RadioButton GroupName="image" IsChecked="{Binding IsRelease}" Content="A release:" VerticalAlignment="Center" />
        <TextBox Name="ReleaseBox" Text="{Binding Release}" PlaceholderText="v0.7.0" Width="140" IsEnabled="{Binding IsRelease}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <RadioButton GroupName="image" IsChecked="{Binding IsFile}" Content="A file:" VerticalAlignment="Center" />
        <TextBox Text="{Binding File}" PlaceholderText="juggle-os-v0.7.0.img.xz" Width="300" IsEnabled="{Binding IsFile}" />
        <Button Content="Browse…" Click="Browse" IsEnabled="{Binding IsFile}" />
      </StackPanel>
      <TextBlock Classes="error" Text="{Binding ImageError}" IsVisible="{Binding ImageError, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <CheckBox IsChecked="{Binding Eject}" Content="Safely eject the card when done" Margin="0,8,0,0" />
      <TextBlock Classes="note" Text="Next: the card, the Pi's settings, then a last check before anything is written. Writing the card asks for administrator rights." />
    </StackPanel>
  </DockPanel>
</UserControl>
