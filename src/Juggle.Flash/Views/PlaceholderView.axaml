<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Juggle.Flash.ViewModels"
             x:Class="Juggle.Flash.Views.PlaceholderView"
             x:DataType="vm:PlaceholderViewModel">
  <StackPanel Spacing="8" MaxWidth="560" HorizontalAlignment="Left">
    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Opacity="0.7" />
  </StackPanel>
</UserControl>
