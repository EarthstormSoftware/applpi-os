<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Juggle.Flash.ViewModels"
             xmlns:core="using:Juggle.Core"
             x:Class="Juggle.Flash.Views.ChooseDiskView"
             x:DataType="vm:ChooseDiskViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Classes="buttons">
      <Button Content="Cancel" Command="{Binding CancelCommand}" />
      <Button Classes="accent" Content="Continue" Command="{Binding ContinueCommand}" />
    </StackPanel>
    <StackPanel Spacing="10" MaxWidth="560" HorizontalAlignment="Left">
      <TextBlock Classes="title" Text="{Binding Title}" />
      <TextBlock Classes="note" Text="Only cards in card readers are shown." />
      <ListBox Name="Disks" ItemsSource="{Binding Disks}" SelectedItem="{Binding Selected}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="core:RemovableDisk">
            <TextBlock Text="{Binding Description}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>
  </DockPanel>
</UserControl>
