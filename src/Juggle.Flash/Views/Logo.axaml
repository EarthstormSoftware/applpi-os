<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Juggle.Flash.Views.Logo">
  <!-- Juggle OS's icon (deploy\branding\juggle-os-icon.svg): three balls on a figure of eight, its line and the balls'
       rings dark on a light theme and light on a dark one, as the logo's light and dark masters -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="LogoLine" Color="#15171A" />
          <SolidColorBrush x:Key="LogoRing" Color="#FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="LogoLine" Color="#F4F2EE" />
          <SolidColorBrush x:Key="LogoRing" Color="#15171A" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Viewbox Stretch="Uniform">
    <Canvas Width="200" Height="150">
      <Path Data="M100 75 C130 30 175 30 175 75 C175 120 130 120 100 75 C70 30 25 30 25 75 C25 120 70 120 100 75 Z"
            Stroke="{DynamicResource LogoLine}" StrokeThickness="11" StrokeLineCap="Round" />
      <Ellipse Canvas.Left="34" Canvas.Top="24" Width="34" Height="34" Fill="#3DDC84" Stroke="{DynamicResource LogoRing}" StrokeThickness="5" />
      <Ellipse Canvas.Left="83" Canvas.Top="58" Width="34" Height="34" Fill="#FFB020" Stroke="{DynamicResource LogoRing}" StrokeThickness="5" />
      <Ellipse Canvas.Left="132" Canvas.Top="92" Width="34" Height="34" Fill="#4DA3FF" Stroke="{DynamicResource LogoRing}" StrokeThickness="5" />
    </Canvas>
  </Viewbox>
</UserControl>
