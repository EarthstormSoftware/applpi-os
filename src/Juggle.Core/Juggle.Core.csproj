<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Sector-aligned buffers for writing cards (ImageWriter) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Juggle.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.5" />
    <PackageReference Include="System.Management" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
  </ItemGroup>

</Project>
