<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>applpi</AssemblyName>
    <RootNamespace>ApplPi.Cli</RootNamespace>
    <!-- On Linux, without the ICU library (a Pi's image has none): applpi only needs invariant formatting -->
    <InvariantGlobalization Condition="$(RuntimeIdentifier.StartsWith('linux'))">true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApplPi.Core\ApplPi.Core.csproj" />
  </ItemGroup>

</Project>
