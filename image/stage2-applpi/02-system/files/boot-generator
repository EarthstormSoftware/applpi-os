#!/bin/sh
# A systemd generator: mounts the boot partition at /boot/firmware. It's partition 1 of the card the root is on,
# whose disk ID is in root=PARTUUID=<disk ID>-<partition> on the kernel command line, so the image doesn't name its
# own partition IDs (an OS update writes another image into the other root slot) and both slots find the same boot
# partition.
set -eu

disk_id=$(sed -n 's/.*root=PARTUUID=\([0-9a-fA-F]\{8\}\)-[0-9]\{2\}.*/\1/p' /proc/cmdline)
# Booted some other way: leave /boot/firmware alone
[ -n "$disk_id" ] || exit 0

dev=/dev/disk/by-partuuid/${disk_id}-01
fsck="systemd-fsck@$(systemd-escape --path "$dev").service"

cat > "$1/boot-firmware.mount" <<- EOF
	# Made by $0
	[Unit]
	Description=Boot partition
	Requires=$fsck
	After=$fsck
	Before=local-fs.target

	[Mount]
	What=$dev
	Where=/boot/firmware
	Type=vfat
	Options=defaults
EOF
mkdir -p "$1/local-fs.target.requires"
ln -sf ../boot-firmware.mount "$1/local-fs.target.requires/boot-firmware.mount"
