#!/bin/bash
# The Wi-Fi check, as the Picos have: if the Pi has Wi-Fi settings but no network a while after starting (6 hours
# unless set otherwise, or 5 minutes for Wi-Fi settings it hasn't connected with yet, which may be mistyped: Wi-Fi
# didn't connect, and Ethernet isn't there either), it restarts into setup mode for a while
# (10 minutes), so it can be given new Wi-Fi settings without reflashing (a new router, a changed password). After
# that it tries Wi-Fi again, so a router that was only off for a while is found again. Not on an OS update's trial
# boot: that has its own check, and goes back. The fallback can be switched off, and both times changed, in the
# settings (wifi_fallback); apply-settings writes /run/applpi/wifi-check only when it's on.
set -u
WAIT_SECONDS=300
PROVEN=
. /run/applpi/wifi-check
PROVEN_FILE=/data/settings/wifi-proven

if /usr/lib/applpi/os-update status 2> /dev/null | grep -qx 'tryboot=1'; then
	exit 0
fi
if /usr/lib/systemd/systemd-networkd-wait-online --any --operational-state=routable --timeout="$WAIT_SECONDS"; then
	# Connected over Wi-Fi (not only Ethernet): these settings work, so the long wait is theirs from now on
	if [ -n "$PROVEN" ] && ip -4 -o addr show dev wlan0 scope global 2> /dev/null | grep -q inet; then
		if [ "$(cat "$PROVEN_FILE" 2> /dev/null)" != "$PROVEN" ]; then
			echo "$PROVEN" > "$PROVEN_FILE.tmp" && mv "$PROVEN_FILE.tmp" "$PROVEN_FILE"
			echo "Wi-Fi connected: its settings are known to work"
		fi
		# A network the app changed to has passed its trial
		rm -f /data/settings/wifi-trial /data/settings/wifi-previous.json
		sync
	fi
	exit 0
fi
# A network the app changed to that didn't connect: back to the one before, rather than setup mode
if /usr/lib/applpi/apply-settings --wifi-give-up; then
	echo "The new Wi-Fi network didn't connect within $((WAIT_SECONDS / 60)) minutes: back to the one before"
	systemctl --no-block reboot
	exit 0
fi
# Without the Wi-Fi dongle there's no hotspot either
if [ ! -e /sys/class/net/wlan0 ]; then
	echo "No network, and no Wi-Fi to run setup mode on"
	exit 0
fi
echo "Wi-Fi didn't connect within $((WAIT_SECONDS / 60)) minutes: restarting into setup mode"
touch /data/settings/setup-next
sync
systemctl --no-block reboot
