#!/bin/sh
# For the login screens:
#   slot          the OS slot running now: "A", or "B (on trial: a restart goes back to A)" when it was started by
#                 tryboot and isn't permanent yet
#   slot update   the last OS update (from os-update's record on the data partition), as labelled lines in colour,
#                 or nothing if there's been none:
#                   Last updated  Successful, 2026-10-26 11:40 CET
#                   Last updated  Failed, 2026-10-26 11:36 CET: v0.2.0-broken
#                                 A service failed to start: example.service
#   slot app      the app, as a labelled line in colour (and its error on the next line, if it couldn't start):
#                   App           hello 1.0.0, running
#   slot issue    writes the console's /etc/issue from its template with all three, and in setup mode how to reach
#                 the setup page (from /run/applpi/setup-console)
#   slot refresh  writes /etc/issue and has the console redraw it (when the slot or the app changes)
set -eu

partition=$(sed -n 's/.*root=PARTUUID=[0-9a-fA-F]\{8\}-\([0-9]\{2\}\).*/\1/p' /proc/cmdline)
case "$partition" in
	02) current=A ;;
	03) current=B ;;
	*) current=unknown ;;
esac
slot=$current
permanent=$(sed -n 's|^os_prefix=slot\([AB]\)/.*|\1|p' /boot/firmware/config.txt 2>/dev/null || true)
if [ "$slot" != unknown ] && [ -n "$permanent" ] && [ "$permanent" != "$slot" ]; then
	slot="$slot (on trial: a restart goes back to $permanent)"
fi

green=$(printf '\033[32m')
reset=$(printf '\033[0m')
# Orange: a terminal's 256-colour orange over SSH; the console has 16 colours, and its "yellow" is a brownish orange
orange=$(printf '\033[38;5;208m')

last_update() {
	[ -r /data/.os-update-last ] || return 0
	UPDATE_WRITTEN='' UPDATE_SLOT='' UPDATE_VERSION='' UPDATE_TRIED='' UPDATE_RESULT=''
	. /data/.os-update-last
	when=$(date -d "@$UPDATE_WRITTEN" '+%Y-%m-%d %H:%M %Z')
	label='Last updated  '
	indent='              '
	case "$UPDATE_RESULT" in
		kept)
			printf '%s%sSuccessful%s, %s\n' "$label" "$green" "$reset" "$when" ;;
		failed:*)
			printf '%s%sFailed%s, %s: %s\n%s%s\n' "$label" "$orange" "$reset" "$when" "$UPDATE_VERSION" "$indent" \
				"${UPDATE_RESULT#failed: }" ;;
		*)
			if [ "$UPDATE_TRIED" != 1 ]; then
				printf '%sWaiting, %s: %s is in slot %s, not tried yet\n' "$label" "$when" "$UPDATE_VERSION" "$UPDATE_SLOT"
			elif [ "$current" = "$UPDATE_SLOT" ]; then
				printf '%sChecking, %s: %s\n' "$label" "$when" "$UPDATE_VERSION"
			else
				printf '%s%sFailed%s, %s: %s\n%sIt didn'\''t start, or it hung\n' "$label" "$orange" "$reset" "$when" \
					"$UPDATE_VERSION" "$indent"
			fi ;;
	esac
}

# The app (applpi-app.service), from what app run found when it last started it
app() {
	label='App           '
	if [ ! -e /data/app/main.py ]; then
		printf '%snone\n' "$label"
		return 0
	fi
	APP_NAME='' APP_VERSION='' APP_ERROR=''
	[ -r /run/applpi/app ] && . /run/applpi/app
	if [ -n "$APP_ERROR" ]; then
		printf '%s%sNot started%s\n              %s\n' "$label" "$orange" "$reset" "$APP_ERROR"
		return 0
	fi
	# Run by the service as it stops (ExecStopPost, which has SERVICE_RESULT), it's stopped whatever systemd says
	sub_state=stopped
	[ -n "${SERVICE_RESULT:-}" ] || sub_state=$(systemctl show -p SubState --value applpi-app.service)
	case "$sub_state" in
		running) state="${green}running${reset}" ;;
		auto-restart) state="${orange}restarting${reset}" ;;
		failed) state="${orange}failed${reset}" ;;
		dead|stop*|final*) state="${orange}stopped${reset}" ;;
		*) state=starting ;;
	esac
	printf '%s%s%s\n' "$label" "${APP_NAME:+$APP_NAME $APP_VERSION, }" "$state"
}

# The console's text, indented by two; without backslashes (agetty's escapes)
issue() {
	orange=$(printf '\033[33m')
	SLOT=$slot UPDATE=$(last_update | tr -d '\\') APP=$(app | tr -d '\\') \
	SETUP=$(cat /run/applpi/setup-console 2> /dev/null | tr -d '\\') awk '
		function block(name,    n, i, lines) {
			n = split(ENVIRON[name], lines, "\n")
			for (i = 1; i <= n; i++) if (lines[i] != "") print "  " lines[i]
		}
		index($0, "@UPDATE@") { block("UPDATE"); next }
		index($0, "@APP@") { block("APP"); next }
		index($0, "@SETUP@") { block("SETUP"); next }
		(at = index($0, "@SLOT@")) { $0 = substr($0, 1, at - 1) ENVIRON["SLOT"] substr($0, at + 6) }
		{ print }' /usr/share/applpi/issue > /etc/issue
}

case "${1:-}" in
	update)
		last_update ;;
	app)
		app ;;
	issue)
		issue ;;
	refresh)
		issue
		agetty --reload 2> /dev/null || true ;;
	*)
		printf '%s\n' "$slot" ;;
esac
