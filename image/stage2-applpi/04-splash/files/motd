#!/bin/bash
# The SSH login screen (/etc/update-motd.d/00-applpi): cleared, then the apple beside the same information as the
# console's (/etc/issue)
. /etc/applpi-release
ipv4=$(ip -o -4 addr show scope global | awk '{ split($4, a, "/"); print a[1]; exit }')
ipv6=$(ip -o -6 addr show scope global | awk '{ split($4, a, "/"); print a[1]; exit }')
info=(
	""
	$'\e[32mApplPi OS\e[0m '"${VERSION}, build ${BUILD_STAMP} UTC"
	""
	"Name          $(hostname).local"
	"IPv4          ${ipv4:-none}"
	"IPv6          ${ipv6:-none}"
)
# The app, and the OS slot
mapfile -t -O "${#info[@]}" info < <(/usr/lib/applpi/slot app)
info+=("OS slot       $(/usr/lib/applpi/slot)")
# The last OS update, if there's been one: a line or two, labelled and coloured
mapfile -t -O "${#info[@]}" info < <(/usr/lib/applpi/slot update)
mapfile -t logo < /usr/share/applpi/logo.ansi
blank=$(printf '%*s' "$(printf '%s' "${logo[0]}" | sed 's/\x1b\[[0-9;]*m//g' | wc -m)" '')

printf '\e[H\e[2J\n'
lines=$(( ${#logo[@]} > ${#info[@]} ? ${#logo[@]} : ${#info[@]} ))
for (( i = 0; i < lines; i++ )); do
	printf '%s   %s\n' "${logo[$i]:-$blank}" "${info[$i]:-}"
done
echo
