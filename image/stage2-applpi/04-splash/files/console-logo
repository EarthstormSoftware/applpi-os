#!/usr/bin/python3
"""Draws the ApplPi OS logo in the top left corner of the console (tty1), above the text (/etc/issue starts with
blank lines to leave room for it, and the logo lines up with the text's two-space indent).

The console is text, so the logo goes straight into the framebuffer, and is drawn again whenever the console has
drawn over it (a cleared screen, the screen waking from blanking). It is only drawn while tty1 is showing. The logo is
rendered at build time as raw RGB, flattened onto the console's black background (console-logo.rgb, with its width
and height in console-logo.size).
"""

import time
from pathlib import Path

LOGO = Path("/usr/share/applpi/console-logo.rgb")
SIZE = Path("/usr/share/applpi/console-logo.size")
FRAMEBUFFER = Path("/dev/fb0")
FRAMEBUFFER_INFO = Path("/sys/class/graphics/fb0")
ACTIVE_TTY = Path("/sys/class/tty/tty0/active")
MARGIN = 16
INTERVAL = 2


def logo_rows(bits_per_pixel: int) -> tuple[int, list[bytes]]:
    """The logo's width and its rows of pixels in the framebuffer's format (16-bit RGB565 or 32-bit XRGB)."""
    width, height = map(int, SIZE.read_text().split())
    rgb = LOGO.read_bytes()
    rows = []
    for y in range(height):
        row = bytearray()
        for x in range(width):
            r, g, b = rgb[(y * width + x) * 3:(y * width + x) * 3 + 3]
            if bits_per_pixel == 16:
                row += (((r >> 3) << 11) | ((g >> 2) << 5) | (b >> 3)).to_bytes(2, "little")
            else:
                row += bytes((b, g, r, 0xFF))
        rows.append(bytes(row))
    return width, rows


def main() -> None:
    while not FRAMEBUFFER.exists():
        time.sleep(INTERVAL)
    bits_per_pixel = int((FRAMEBUFFER_INFO / "bits_per_pixel").read_text())
    stride = int((FRAMEBUFFER_INFO / "stride").read_text())
    _, rows = logo_rows(bits_per_pixel)
    left = MARGIN * bits_per_pixel // 8
    positions = [(MARGIN + y) * stride + left for y in range(len(rows))]

    with open(FRAMEBUFFER, "r+b", buffering=0) as framebuffer:
        while True:
            if ACTIVE_TTY.read_text().strip() == "tty1":
                for position, row in zip(positions, rows):
                    framebuffer.seek(position)
                    if framebuffer.read(len(row)) != row:
                        for position_, row_ in zip(positions, rows):
                            framebuffer.seek(position_)
                            framebuffer.write(row_)
                        break
            time.sleep(INTERVAL)


if __name__ == "__main__":
    main()
