[Plymouth Theme]
Name=Juggle
Description=The Juggle OS logo with a spinner
ModuleName=two-step

[two-step]
ImageDir=/usr/share/plymouth/themes/juggle
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.45
HorizontalAlignment=.5
VerticalAlignment=.65
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.382
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x15171A
BackgroundEndColor=0x15171A
