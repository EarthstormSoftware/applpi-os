#!/usr/bin/python3
"""Draws the Juggle OS icon in the top left corner of the console (tty1), once for each CPU core, in a row above the
text (/etc/issue starts with blank lines to leave room for it, and the icons line up with the text's two-space indent).

The console is text, so the logo goes straight into the framebuffer, and is drawn again whenever the console has
drawn over it (a cleared screen, the screen waking from blanking). It is only drawn while tty1 is showing. The icon is
rendered at build time as raw RGB, flattened onto the console's black background (console-logo.rgb, with its width
and height in console-logo.size).
"""

import os
import time
from pathlib import Path

LOGO = Path("/usr/share/juggle/console-logo.rgb")
SIZE = Path("/usr/share/juggle/console-logo.size")
FRAMEBUFFER = Path("/dev/fb0")
FRAMEBUFFER_INFO = Path("/sys/class/graphics/fb0")
ACTIVE_TTY = Path("/sys/class/tty/tty0/active")
MARGIN = 16
GAP = 16
INTERVAL = 2


def pixel(r: int, g: int, b: int, bits_per_pixel: int) -> bytes:
    """A pixel in the framebuffer's format (16-bit RGB565 or 32-bit XRGB)."""
    if bits_per_pixel == 16:
        return (((r >> 3) << 11) | ((g >> 2) << 5) | (b >> 3)).to_bytes(2, "little")
    return bytes((b, g, r, 0xFF))


def logo_rows(bits_per_pixel: int, count: int) -> list[bytes]:
    """The rows of pixels of count icons side by side, GAP apart, in the framebuffer's format."""
    width, height = map(int, SIZE.read_text().split())
    rgb = LOGO.read_bytes()
    gap = pixel(0, 0, 0, bits_per_pixel) * GAP
    rows = []
    for y in range(height):
        icon = b"".join(pixel(*rgb[(y * width + x) * 3:(y * width + x) * 3 + 3], bits_per_pixel) for x in range(width))
        rows.append(gap.join([icon] * count))
    return rows


def main() -> None:
    while not FRAMEBUFFER.exists():
        time.sleep(INTERVAL)
    bits_per_pixel = int((FRAMEBUFFER_INFO / "bits_per_pixel").read_text())
    stride = int((FRAMEBUFFER_INFO / "stride").read_text())
    # As many as fit across the screen, so a narrow one doesn't wrap them onto the next lines
    screen_width = int((FRAMEBUFFER_INFO / "virtual_size").read_text().split(",")[0])
    icon_width = int(SIZE.read_text().split()[0])
    fits = max(1, (screen_width - 2 * MARGIN + GAP) // (icon_width + GAP))
    rows = logo_rows(bits_per_pixel, min(os.cpu_count() or 1, fits))
    left = MARGIN * bits_per_pixel // 8
    positions = [(MARGIN + y) * stride + left for y in range(len(rows))]

    with open(FRAMEBUFFER, "r+b", buffering=0) as framebuffer:
        while True:
            if ACTIVE_TTY.read_text().strip() == "tty1":
                for position, row in zip(positions, rows):
                    framebuffer.seek(position)
                    if framebuffer.read(len(row)) != row:
                        for position_, row_ in zip(positions, rows):
                            framebuffer.seek(position_)
                            framebuffer.write(row_)
                        break
            time.sleep(INTERVAL)


if __name__ == "__main__":
    main()
