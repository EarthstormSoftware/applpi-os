[Unit]
Description=Juggle app (in /data/app)
Requires=juggle-data.service
After=juggle-data.service juggle-settings.service network.target
ConditionPathExists=/data/app/main.py
# Not in setup mode: the setup page has port 80
ConditionPathExists=!/run/juggle/setup
# Restarted however often it stops, like a Pico's watchdog restarting it
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/lib/juggle/app run
# The console's text shows whether it's running (app run updates it when it starts)
ExecStopPost=-/usr/lib/juggle/slot refresh
WorkingDirectory=/data/app
Environment=PYTHONPATH=/data/app/lib PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
Environment=JUGGLE_STATE=/data/app-state HOME=/data/app-state
Restart=always
RestartSec=5
# The app can ask for systemd's watchdog itself (WATCHDOG_USEC=, then WATCHDOG=1 while it's well, as App Base does),
# so a hung app is restarted, not only one that stops; an app that doesn't ask has none
NotifyAccess=main
RestartPreventExitStatus=78

[Install]
WantedBy=multi-user.target
