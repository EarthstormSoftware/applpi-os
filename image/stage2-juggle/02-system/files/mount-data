#!/bin/bash
# Mounts the data partition at /data. On first boot it also makes root B (partition 3, the same size as root A) and
# the data partition (4, the rest of the card).
set -euo pipefail

# The card is the disk holding the root partition named on the kernel command line
root_partuuid=$(sed -n 's/.*root=PARTUUID=\([^ ]*\).*/\1/p' /proc/cmdline)
root_dev=$(blkid -l -o device -t "PARTUUID=${root_partuuid}")
disk=/dev/$(lsblk -ndo PKNAME "${root_dev}")

# The device of partition $1 on the card, or nothing if there isn't one
part_dev() {
	local p
	for p in /sys/class/block/"${disk##*/}"/*/partition; do
		if [ -e "$p" ] && [ "$(cat "$p")" = "$1" ]; then
			echo "/dev/$(basename "$(dirname "$p")")"
		fi
	done
}

new_data=
if [ -z "$(part_dev 3)" ] || [ -z "$(part_dev 4)" ]; then
	echo "Laying out the card: root B and the data partition"
	new_data=1
	read -r slot_start slot_size < <(partx -g -o START,SECTORS -n 2 "$disk")
	b_start=$((slot_start + slot_size))
	data_start=$((b_start + slot_size))
	if [ $(($(blockdev --getsz "$disk") - data_start)) -lt $((512 * 2048)) ]; then
		echo "The card is too small: it needs room for root B and at least 512 MiB of data" >&2
		exit 1
	fi
	{
		[ -n "$(part_dev 3)" ] || echo "start=${b_start}, size=${slot_size}, type=83"
		echo "start=${data_start}, type=83"
	} | sfdisk --quiet --append --no-reread "$disk"
	# The card is in use, so the kernel is told about the new partitions one by one
	partx --add --nr 3:4 "$disk" || true
	udevadm settle
	if [ -z "$(part_dev 4)" ]; then
		echo "The data partition was made but the kernel can't see it" >&2
		exit 1
	fi
fi

data_dev=$(part_dev 4)
# A data partition made on this boot is formatted even if a filesystem is found there: a card flashed again still has
# the last OS's data partition in the same place, with its app, the app's state and settings
if [ -n "$new_data" ] || [ -z "$(blkid -o value -s TYPE "$data_dev")" ]; then
	echo "Formatting the data partition"
	mkfs.ext4 -q -F -L juggle-data "$data_dev"
fi

if ! mountpoint -q /data; then
	fsck.ext4 -p "$data_dev" || [ $? -le 1 ]
	mount -o noatime "$data_dev" /data
fi
install -d -m 700 /data/settings /data/ssh
# The app's own (app installs the app in /data/app); /data/apps was v0.2.0's
install -d -m 700 -o app -g app /data/app-state
rmdir /data/apps 2> /dev/null || true
