<Project>

  <!-- The version comes from the latest release tag (vX.Y.Z), as for the image: see docs\roadmap.md -->
  <PropertyGroup>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <Target Name="JuggleVersion" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo">
    <Exec Command="git describe --tags --match &quot;v[0-9]*&quot; --always --dirty" ConsoleToMSBuild="true"
          StandardOutputImportance="low" IgnoreExitCode="true" WorkingDirectory="$(MSBuildThisFileDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="JuggleGitVersion" />
      <Output TaskParameter="ExitCode" PropertyName="JuggleGitExitCode" />
    </Exec>
    <PropertyGroup Condition="'$(JuggleGitExitCode)' == '0'">
      <InformationalVersion>$(JuggleGitVersion)</InformationalVersion>
      <!-- The numeric part for the file version: v0.1.0-3-g1ad84dc gives 0.1.0 -->
      <JuggleNumericVersion>$([System.Text.RegularExpressions.Regex]::Match($(JuggleGitVersion), '^v(\d+\.\d+\.\d+)').Groups[1].Value)</JuggleNumericVersion>
      <Version Condition="'$(JuggleNumericVersion)' != ''">$(JuggleNumericVersion)</Version>
      <FileVersion Condition="'$(JuggleNumericVersion)' != ''">$(JuggleNumericVersion).0</FileVersion>
    </PropertyGroup>
  </Target>

</Project>
